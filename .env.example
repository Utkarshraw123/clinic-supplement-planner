# Local dev uses file:local.db when these are unset
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SESSION_SECRET=change-me-in-production-min-32-chars

# Control-plane DB (multi-tenant registry). Local dev defaults to file:control.db
CONTROL_DATABASE_URL=
CONTROL_AUTH_TOKEN=

# Turso Platform API (free) — needed to provision new clinic databases on signup
TURSO_PLATFORM_TOKEN=
TURSO_ORG=
TURSO_GROUP=

# Stripe (test keys) — billing + checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
APP_BASE_URL=

# Protects the reminders cron endpoint (/api/cron/reminders). Set the same value in Vercel.
CRON_SECRET=
